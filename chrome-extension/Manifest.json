{
  "name": "NeuralMail AI - Smart Email Assistant",
  "description": "AI-powered email reply generator with intent detection. No login required.",
  "version": "2.0.0",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://neuralmail-ai.onrender.com/*",
    "*://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "Popup.html",
    "default_title": "NeuralMail AI"
  }
}